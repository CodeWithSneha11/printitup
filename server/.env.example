PORT=5000

# Comma-separated list of frontend origins allowed to call this server
ALLOWED_ORIGINS=http://localhost:3000

# Get your key at https://aistudio.google.com/apikey
# NOTE: as of late 2025 the free tier for image generation is 0 IPM.
# You must enable billing on the Google Cloud project behind this key
# for /api/generate-image to work. Tier 1 billing gives 10 images/min
# with no minimum spend, but a card must be on file.
#GEMINI_API_KEY=your_gemini_api_key_here

# Path to the service account JSON downloaded from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Defaults to ./serviceAccountKey.json if omitted.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
 
 